/*
 * Ardósia — Esmeralda
 * Tema escuro para Mod Organizer 2 (Qt Style Sheet)
 *
 * Instalação: copie este arquivo e a pasta "ardosia" para <MO2>/stylesheets/
 * e escolha "Ardosia Esmeralda" em Settings > Theme > Style.
 *
 * Cores que NÃO ficam no .qss — defina em Settings > Theme > Colors:
 *   Is overwriting (loose files) ......... #A0C8463D
 *   Is overwritten (loose files) ......... #E8564E47
 *   Is overwriting (archives) ............ #A0C8461C
 *   Is overwritten (archives) ............ #E8564E1F
 *   Mod contains selected file ........... #9680F042
 *   Plugin is contained in selected mod .. #9680F042
 *   (#RRGGBBAA — no seletor de cor do MO2, ajuste o canal Alfa)
 *
 * Separadores: clique direito no separador > Select Color... > #2A3546
 *
 * Regra do tema: nenhum background nem border em ::item, para não
 * descartar as cores de conflito e de separador que o MO2 pinta nas linhas.
 */

/* ==================== Base ==================== */
* {
  font-family: "Inter Variable", "Inter", "Segoe UI Variable Text", "Segoe UI";
  font-size: 10pt;                       /* body */
}
QWidget {
  background-color: #171B21;             /* bg-1 */
  color: #D9DFE6;                        /* text-primary */
  selection-background-color: rgba(51, 199, 155, 0.26);   /* selection */
  selection-color: #F2F5F8;              /* text-strong */
}
QWidget:disabled { color: #525B67; }     /* text-disabled */
QMainWindow::separator, QSplitter::handle { background: #171B21; width: 6px; height: 6px; }
QSplitter::handle:hover { background: rgba(51, 199, 155, 0.12); }   /* accent-subtle */
QStatusBar { background: #171B21; border-top: 1px solid #323A45; color: #97A2B0; font-size: 9pt; }
QStatusBar > QLabel { padding-left: 8px; padding-right: 8px; }   /* só os filhos diretos: ícone e texto de Notifications ficam juntos */
/* QMainWindow ignora a margem da status bar; o splitter central é um QFrame, então o padding dele afasta tudo da borda */
#categoriesSplitter { padding-bottom: 6px; }
QStatusBar::item { border: none; }

/* ==================== Barra de ferramentas e menus ==================== */
QToolBar { background: #171B21; border: none; border-bottom: 1px solid #323A45; padding: 6px 10px; spacing: 4px;
           qproperty-iconSize: 24px 24px; }
QToolBar::separator { background: #323A45; width: 1px; margin: 6px 8px; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 5px; color: #97A2B0; }
QToolButton:hover   { background: #2F3640; border-color: #323A45; color: #F2F5F8; }
QToolButton:pressed { background: #39414C; border-color: #47515E; }
QToolButton:checked { background: rgba(51, 199, 155, 0.12); color: #4FD1AA; }
QToolButton::menu-indicator { image: none; }

/* O MO2 lê o ícone destes seletores e o aplica na barra e no menu */
#actionChange_Game { qproperty-icon: url(./ardosia/tb-instances.svg); }
#actionInstallMod { qproperty-icon: url(./ardosia/tb-install.svg); }
#actionNexus, #actionModPage { qproperty-icon: url(./ardosia/tb-nexus.svg); }
#actionAdd_Profile { qproperty-icon: url(./ardosia/tb-profile.svg); }
#action_Refresh { qproperty-icon: url(./ardosia/tb-refresh.svg); }
#actionModify_Executables { qproperty-icon: url(./ardosia/tb-exe.svg); }
#actionTool { qproperty-icon: url(./ardosia/tb-tools.svg); }
#actionSettings { qproperty-icon: url(./ardosia/tb-settings.svg); }
#actionEndorseMO { qproperty-icon: url(./ardosia/tb-endorse.svg); }
#actionNotifications { qproperty-icon: url(./ardosia/tb-problems.svg); }
#actionUpdate { qproperty-icon: url(./ardosia/tb-update.svg); }
#actionHelp { qproperty-icon: url(./ardosia/tb-help.svg); }

QMenuBar { background: #171B21; padding: 0 6px; }
QMenuBar::item { padding: 4px 10px; border-radius: 4px; background: transparent; }
QMenuBar::item:selected { background: #2F3640; color: #F2F5F8; }

QMenu { background: #20262E; border: 1px solid #47515E; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 5px 24px 5px 12px; border-radius: 4px; min-height: 18px; background: transparent; }
QMenu::item:selected { background: rgba(51, 199, 155, 0.26); color: #F2F5F8; }
QMenu::item:disabled { color: #525B67; background: transparent; }
QMenu::separator { height: 1px; background: #323A45; margin: 4px 6px; }
QMenu::icon { padding-left: 8px; }
QMenu::right-arrow { image: url(./ardosia/chevron-right.svg); width: 16px; height: 16px; }
QMenu::indicator:checked { image: url(./ardosia/check.svg); background: #33C79B; border-radius: 3px; width: 14px; height: 14px; }

QToolTip { background: #2C333D; color: #D9DFE6; border: 1px solid #47515E; border-radius: 6px; padding: 6px 8px; font-size: 9pt; }

/* ==================== Botões ==================== */
QPushButton { background: #262C35; border: 1px solid #323A45; border-radius: 4px; padding: 5px 12px; min-height: 16px; color: #D9DFE6; }
QPushButton:hover    { background: #2F3640; border-color: #47515E; }
QPushButton:pressed  { background: #39414C; border-color: #47515E; }
QPushButton:focus    { border-color: #33C79B; }                        /* focus-ring */
QPushButton:disabled { background: #1C2128; border-color: #252B33; color: #525B67; }
QPushButton::menu-indicator { image: url(./ardosia/chevron-down.svg); width: 16px; height: 16px; subcontrol-position: right center; right: 6px; }

/* Primário: Executar */
QPushButton#startButton { background: #33C79B; border-color: #33C79B; color: #14181D; font-weight: 600; }
QPushButton#startButton:hover    { background: #52D4AD; border-color: #52D4AD; }
QPushButton#startButton:pressed  { background: #27A882; border-color: #27A882; }
QPushButton#startButton:focus    { border-color: #F2F5F8; }
QPushButton#startButton:disabled { background: #262C35; border-color: #252B33; color: #525B67; }

/* Ícones dos botões da janela principal */
#listOptionsBtn { qproperty-icon: url(./ardosia/btn-options.svg); }
#openFolderMenu { qproperty-icon: url(./ardosia/btn-folder.svg); }
#restoreModsButton, #restoreButton { qproperty-icon: url(./ardosia/btn-restore.svg); }
#saveModsButton, #saveButton { qproperty-icon: url(./ardosia/btn-backup.svg); }
#sortButton { qproperty-icon: url(./ardosia/btn-sort.svg); }
#dataTabRefresh, #btnRefreshDownloads { qproperty-icon: url(./ardosia/btn-refresh.svg); }
#clearFiltersButton { qproperty-icon: url(./ardosia/btn-clear.svg); }
#startButton { qproperty-icon: url(./ardosia/btn-run.svg); }
#linkButton { qproperty-icon: url(./ardosia/btn-link.svg); }
#listOptionsBtn, #openFolderMenu, #restoreModsButton, #restoreButton, #saveModsButton, #saveButton, #sortButton,
#dataTabRefresh, #btnRefreshDownloads, #clearFiltersButton, #startButton, #linkButton { qproperty-iconSize: 16px 16px; }

/* O layout dos botões deste diálogo herda spacing 0 no MO2, e o QSS não define spacing de layout */
#QueryOverwriteDialog QPushButton { margin-left: 8px; }

/* ==================== Campos e combos ==================== */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
  background: #12161B; border: 1px solid #323A45; border-radius: 4px; padding: 4px 8px; min-height: 18px; color: #D9DFE6; }
QLineEdit:hover, QSpinBox:hover, QPlainTextEdit:hover { border-color: #47515E; }
QLineEdit:focus, QSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #33C79B; }
QLineEdit:disabled, QSpinBox:disabled { background: #171B21; border-color: #252B33; color: #525B67; }

QComboBox { background: #262C35; border: 1px solid #323A45; border-radius: 4px; padding: 4px 8px; min-height: 18px; }
QComboBox:hover    { background: #2F3640; border-color: #47515E; }
QComboBox:focus, QComboBox:on { border-color: #33C79B; }
QComboBox:disabled { background: #1C2128; border-color: #252B33; color: #525B67; }
QComboBox:editable { background: #12161B; }
QComboBox::drop-down { width: 22px; border: none; border-left: 1px solid #252B33; subcontrol-origin: padding; subcontrol-position: right center; }
QComboBox::down-arrow { image: url(./ardosia/chevron-down.svg); width: 14px; height: 14px; }
QComboBox::down-arrow:disabled { image: url(./ardosia/chevron-down-disabled.svg); }
QComboBox QAbstractItemView { background: #20262E; border: 1px solid #47515E; padding: 4px; outline: 0;
  selection-background-color: rgba(51, 199, 155, 0.26); selection-color: #F2F5F8; }
QComboBox QAbstractItemView::item { min-height: 26px; padding: 0 8px; border-radius: 4px; }

QSpinBox::up-button, QSpinBox::down-button { width: 18px; border: none; background: transparent; }
QSpinBox::up-arrow   { image: url(./ardosia/chevron-up.svg);   width: 12px; height: 12px; }
QSpinBox::down-arrow { image: url(./ardosia/chevron-down.svg); width: 12px; height: 12px; }

/* ==================== Checkboxes (listas e QCheckBox) ==================== */
QCheckBox::indicator, QGroupBox::indicator {
  width: 16px; height: 16px; border: 1px solid #6B7684; border-radius: 3px; background: #12161B; }
QCheckBox::indicator:unchecked:hover { border-color: #33C79B; }
QCheckBox::indicator:checked {
  background: #33C79B; border-color: #33C79B; image: url(./ardosia/check.svg); }
QCheckBox::indicator:checked:hover { background: #52D4AD; border-color: #52D4AD; }
QCheckBox::indicator:indeterminate {
  background: #33C79B; border-color: #33C79B; image: url(./ardosia/check-partial.svg); }
QCheckBox::indicator:disabled { background: transparent; border-color: #323A45; }
QCheckBox::indicator:checked:disabled {
  background: #2F3640; border-color: #2F3640; image: url(./ardosia/check-disabled.svg); }

/* Listas: caixa em imagem, porque em escala de 150% uma lista pode cair em meio pixel e a caixa desenhada pelo QSS sairia cortada.
   O texto vem do estilo nativo, que reserva 13px para o checkbox e não pinta a cor da linha nessa área. A caixa precisa cobrir essa área
   inteira: se sobrar espaço, aparece fundo escuro nas linhas coloridas; se faltar 1px, aparece a borda do checkbox nativo; e se a caixa
   passar da área, a cor da linha é pintada por cima dela. Com 14px, -1px de deslocamento e -1px de margem, ela encaixa
   e o texto não anda entre as linhas normais e as com hover */
QAbstractItemView::indicator { width: 14px; height: 14px; position: relative; left: -1px; margin-right: -1px; image: url(./ardosia/lv-unchecked.svg); }
QAbstractItemView::indicator:unchecked:hover { image: url(./ardosia/lv-unchecked-hover-esmeralda.svg); }
QAbstractItemView::indicator:checked { image: url(./ardosia/lv-checked-esmeralda.svg); }
QAbstractItemView::indicator:checked:hover { image: url(./ardosia/lv-checked-hover-esmeralda.svg); }
QAbstractItemView::indicator:indeterminate { image: url(./ardosia/lv-partial-esmeralda.svg); }
QAbstractItemView::indicator:disabled { image: url(./ardosia/lv-unchecked-disabled.svg); }
QAbstractItemView::indicator:checked:disabled { image: url(./ardosia/lv-checked-disabled.svg); }
QCheckBox { spacing: 8px; }

/* ==================== Abas ==================== */
QTabWidget::pane { background: #1C2128; border: 1px solid #323A45; border-radius: 6px; border-top-left-radius: 0; top: -1px; padding-bottom: 8px; }
QTabBar { background: transparent; }   /* deixa a borda do painel aparecer sob as abas não selecionadas */
QTabBar::tab { background: transparent; color: #97A2B0; border: 1px solid transparent; border-bottom: none;
  border-top: 2px solid transparent; padding: 6px 16px; margin-right: 2px; }
QTabBar::tab:hover    { background: #262C35; color: #F2F5F8; }
QTabBar::tab:selected { background: #1C2128; color: #F2F5F8; font-weight: 600;
  border-color: #323A45; border-top: 2px solid #33C79B; }
QTabBar::tab:disabled { color: #525B67; }

/* ==================== Listas e árvores (modList, espList, Data, Saves, Downloads) ==================== */
QAbstractItemView {
  background: #1C2128;                    /* bg-2 */
  alternate-background-color: #20262E;    /* bg-2-alt */
  border: 1px solid #323A45;              /* sem raio: cabeçalho e linhas cobririam a curva do canto */
  outline: 0; show-decoration-selected: 1;
}
QTreeView { qproperty-indentation: 20; }
/* O MO2 usa spacing 2 nos layouts em volta das listas, e o QSS não define spacing de layout: a margem completa o gap de 8px */
#modList, #espList, #bsaList, #dataTree, #downloadView { margin-top: 6px; }
#modList, #espList, #dataTree, #downloadView, #filters { margin-bottom: 6px; }
#EditExecutablesDialog #list { margin-top: 5px; }
/* NÃO definir background nem border em ::item: com qualquer um dos dois, o Qt desenha só a regra do QSS e descarta a cor
   de conflito/separador do MO2. Em ::item:hover o fundo é o custo aceito: só a linha sob o cursor perde a cor */
QAbstractItemView::item { padding: 4px 0; min-height: 18px; }   /* linha de 26px. Padding lateral não: sem border, o texto vem do estilo nativo e o checkbox iria para cima dele */
QAbstractItemView::item:hover { background: rgba(151, 162, 176, 0.10); color: #F2F5F8; }   /* sem isto, o hover fica azul nativo */
QAbstractItemView::item:selected:active   { background: rgba(51, 199, 155, 0.26); color: #F2F5F8; }
QAbstractItemView::item:selected:!active  { background: rgba(151, 162, 176, 0.18); color: #F2F5F8; }

QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings {
  image: url(./ardosia/branch-closed-esmeralda.svg); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings {
  image: url(./ardosia/branch-open-esmeralda.svg); }

QHeaderView { background: #171B21; border: none; }
QHeaderView::section { background: #171B21; color: #97A2B0; font-size: 9pt; font-weight: 600;
  padding: 4px 8px; min-height: 18px; border: none; border-right: 1px solid #252B33; border-bottom: 1px solid #323A45; }
QHeaderView::section:hover   { background: #2F3640; color: #F2F5F8; }
QHeaderView::section:pressed { background: #39414C; }
QHeaderView::up-arrow   { image: url(./ardosia/sort-up-esmeralda.svg);   width: 12px; height: 12px; subcontrol-position: center right; right: 6px; }
QHeaderView::down-arrow { image: url(./ardosia/sort-down-esmeralda.svg); width: 12px; height: 12px; subcontrol-position: center right; right: 6px; }
QTableCornerButton::section { background: #171B21; border: none; }

/* ==================== Barras de rolagem ==================== */
QScrollBar:vertical   { background: #1C2128; width: 12px;  margin: 0; border: none; border-left: 1px solid #252B33; }
QScrollBar:horizontal { background: #1C2128; height: 12px; margin: 0; border: none; border-top: 1px solid #252B33; }
QScrollBar::handle { background: #39414C; border-radius: 4px; }
QScrollBar::handle:vertical   { min-height: 32px; margin: 2px; }
QScrollBar::handle:horizontal { min-width: 32px;  margin: 2px; }
QScrollBar::handle:hover   { background: #47515E; }
QScrollBar::handle:pressed { background: #7B8696; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ==================== Log, grupos e diálogos ==================== */
#logList, QPlainTextEdit[readOnly="true"] {
  background: #12161B; font-family: "Cascadia Mono", Consolas; font-size: 9pt; border: 1px solid #323A45; }
QGroupBox { border: 1px solid #323A45; border-radius: 6px; margin-top: 14px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #97A2B0; font-weight: 600; }
QDockWidget::title { background: #171B21; padding: 6px 12px; color: #97A2B0; font-weight: 600; }
QProgressBar { background: #12161B; border: 1px solid #323A45; border-radius: 4px; text-align: center; min-height: 14px; }
QProgressBar::chunk { background: #33C79B; border-radius: 3px; }

/* ==================== Ajustes de herança ==================== */
/* QWidget pinta bg-1; páginas de aba e rótulos precisam herdar o fundo do painel */
QTabWidget > QStackedWidget { background: transparent; }
QTabWidget > QStackedWidget > QWidget { background: #1C2128; }
QLabel, QCheckBox, QRadioButton { background: transparent; }
QAbstractScrollArea > QWidget { background: transparent; }
QAbstractItemView > QWidget { background: transparent; }
QToolTip { opacity: 255; }
